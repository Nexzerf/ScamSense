<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Privacy by design — minimal permissions:
        - Message/link/phone analysis is 100% on-device; checked text never leaves the phone.
        - INTERNET is used ONLY to talk to the user's own AI call-assistant server after they
          pair with it (HTTPS only). Nothing is sent if the assistant is not set up.
        - POST_NOTIFICATIONS: warnings about blocked / suspicious calls.
        - Call screening uses the system "call screening" role (number only, never audio).
        - Speech input uses the system recogniser via an Intent (no RECORD_AUDIO).
        - SMS / calls / call-forwarding codes open the user's own apps (no SEND_SMS / CALL_PHONE).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Built-in mode: Wireless debugging only works on Wi‑Fi, so check before trying. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Granted once over ADB after built-in pairing (never by the system to normal apps):
         lets ScamSense switch Wireless debugging back on by itself, e.g. after a reboot. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Live in-call listening (opt-in, Android 11+, requires Shizuku):
         READ_PHONE_STATE only to know when a call is answered / ended (no call log, no numbers). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets the user exempt ScamSense from battery optimisation so the live listener may
         start from the background when a call arrives (Android 12+ FGS restriction). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-sdk tools:overrideLibrary="rikka.shizuku.api,rikka.shizuku.provider,rikka.shizuku.shared,rikka.shizuku.aidl" />

    <!-- Android 11+ package visibility: needed to bind the system text-to-speech engine
         and to launch the system speech recogniser. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".ScamSenseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ScamSense"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.ScamSense.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Share" a suspicious SMS / LINE message to ScamSense -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Select text in any app -> "ตรวจด้วย ScamSense" in the text menu -->
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".livecall.LiveCallService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Listens to an ongoing phone call from an unknown number to warn the user about scams in real time" />
        </service>

        <service
            android:name=".livecall.adb.PairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="One-time pairing with the phone's own Wireless debugging so the call listener works without a separate app" />
        </service>

        <!-- Shizuku binder delivery (https://github.com/RikkaApps/Shizuku-API) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".calls.ScamCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
</manifest>
