<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (user-installed CAs are NOT trusted, so a malicious
     "security certificate" installed by a scammer cannot intercept assistant traffic). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
