# Copy to .env (never commit the real file). All values below are placeholders.
PUBLIC_BASE_URL=https://assist.example.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
ADMIN_TOKEN=replace-with-a-long-random-string-32+chars
STT_LANGUAGE=th-TH
# SPEECH_MODEL=            # optional: a Twilio speech model that supports Thai
TTS_VOICE=Google.th-TH-Standard-A
RETENTION_DAYS=30
MAX_TURNS=3
